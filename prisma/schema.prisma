generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PERSONAL
  ALUNO
  NUTRICIONISTA
}

enum TrainerStudentStatus {
  PENDING
  ACTIVE
  PAUSED
  ENDED
}

enum WorkoutLogStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum InviteStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum WorkoutMode {
  GUIDED
  FREE
}

enum NotificationType {
  // Para o Aluno
  WORKOUT_PLAN_CREATED
  WORKOUT_PLAN_UPDATED
  WORKOUT_EXERCISE_UPDATED
  WORKOUT_SCHEDULE_UPDATED
  WORKOUT_REMINDER_MORNING
  WORKOUT_REMINDER_EVENING
  STREAK_BROKEN
  EXAM_RECEIVED
  TRAINER_COMMENT

  // Para o Personal
  STUDENT_WORKOUT_STARTED
  STUDENT_WORKOUT_FINISHED
  STUDENT_WORKOUT_SKIPPED
  STUDENT_METRIC_ADDED
  STUDENT_EXAM_UPLOADED
  STUDENT_INVITE_ACCEPTED
  STUDENT_INACTIVE
  STUDENT_BIRTHDAY

  // Follow-up forms & eventos (round 3)
  FOLLOWUP_FORM_SENT
  FOLLOWUP_FORM_ANSWERED
  EVENT_REMINDER_PERSONAL
  EVENT_REMINDER_STUDENT

  // Nutrição (vertical nutrição) — round 4
  MEAL_PLAN_CREATED
  MEAL_PLAN_UPDATED
  MEAL_REMINDER
  STUDENT_MEAL_LOGGED
  STUDENT_MEAL_SKIPPED
  NUTRI_COMMENT
  NUTRI_INVITE_ACCEPTED
  NUTRI_FOLLOWUP_FORM_SENT
  NUTRI_FOLLOWUP_FORM_ANSWERED
  HYDRATION_REMINDER
}

enum ExerciseCategory {
  ACADEMIA
  CORRIDA
}

enum FollowUpQuestionType {
  TEXT
  TEXTAREA
  RATING_1_5
  YES_NO
  NUMBER
}

enum FollowUpFormStatus {
  PENDING
  ANSWERED
  EXPIRED
  REVOKED
}

enum EventType {
  RUN_RACE
  COMPETITION
  ONE_OFF_SESSION
  EVALUATION
  OTHER
}

enum GoalMetric {
  WORKOUT_COUNT    // # de treinos concluídos no período
  DISTANCE_KM      // soma de quilômetros corridos no período
}

enum GoalPeriod {
  WEEK
  MONTH
  YEAR
}

model User {
  id              String    @id
  email           String    @unique
  name            String
  role            UserRole?
  avatarUrl       String?
  phone           String?
  birthDate       DateTime?
  height          Float?
  currentWeight   Float?
  goal            String?
  cref            String?
  crn             String?
  sportsPracticed Json?
  preferredVertical Vertical?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trainerLinks    TrainerStudent[] @relation("PersonalRelation")
  studentLinks    TrainerStudent[] @relation("AlunoRelation")
  createdPlans    WorkoutPlan[]    @relation("CreatedByPersonal")
  ownedPlans      WorkoutPlan[]    @relation("PlanOwner")
  workoutLogs     WorkoutLog[]
  bodyMetrics     BodyMetric[]
  examUploads     ExamUpload[]
  runningSessions RunningSession[]
  customExercises Exercise[]       @relation("ExerciseCreator")
  invitesCreated  InviteCode[]     @relation("InviteCreator")
  planMetricLogs  PlanMetricLog[]
  goals           Goal[]

  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  notificationSettings NotificationSettings?
  passkeys             PasskeyCredential[]

  // Follow-up forms (round 3)
  followUpTemplates        FollowUpFormTemplate[] @relation("FollowUpCreator")
  followUpSendsAsTrainer   FollowUpFormSend[]     @relation("FollowUpTrainer")
  followUpSendsAsStudent   FollowUpFormSend[]     @relation("FollowUpStudent")

  // Eventos (round 3)
  trainerEvents Event[] @relation("EventTrainer")
  studentEvents Event[] @relation("EventStudent")

  // Strava (round 3)
  stravaAccount    StravaAccount?
  stravaActivities StravaActivity[]

  // Nutrição (round 4)
  nutritionistLinks    NutritionistStudent[] @relation("NutritionistRelation")
  nutriStudentLinks    NutritionistStudent[] @relation("NutriAlunoRelation")
  nutriInvitesCreated  InviteCodeNutri[]     @relation("InviteNutriCreator")
  nutriInvitesConsumed InviteCodeNutri[]     @relation("InviteNutriConsumer")
  createdMealPlans     MealPlan[]            @relation("MealPlanCreator")
  ownedMealPlans       MealPlan[]            @relation("MealPlanOwner")
  customFoods          FoodCatalog[]         @relation("FoodCatalogCreator")
  mealLogs             MealLog[]
  hydrationLogs        HydrationLog[]

  @@index([email])
  @@index([role])
}

model InviteCode {
  id        String       @id @default(cuid())
  code      String       @unique
  trainerId String
  status    InviteStatus @default(ACTIVE)
  usedById  String?
  expiresAt DateTime
  createdAt DateTime     @default(now())
  usedAt    DateTime?

  trainer User @relation("InviteCreator", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([trainerId])
}

model TrainerStudent {
  id        String               @id @default(cuid())
  trainerId String
  studentId String
  status    TrainerStudentStatus @default(ACTIVE)
  inviteId  String?
  startedAt DateTime             @default(now())
  endedAt   DateTime?

  trainer User @relation("PersonalRelation", fields: [trainerId], references: [id], onDelete: Cascade)
  student User @relation("AlunoRelation", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([trainerId, studentId])
  @@index([trainerId])
  @@index([studentId])
}

model WorkoutPlan {
  id          String    @id @default(cuid())
  trainerId   String?
  studentId   String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  // When set, the plan is paused: still belongs to the student but
  // shouldn't be considered "current". Distinct from isActive=false,
  // which means the plan was retired/inactive permanently.
  pausedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trainer            User?                  @relation("CreatedByPersonal", fields: [trainerId], references: [id])
  student            User                   @relation("PlanOwner", fields: [studentId], references: [id], onDelete: Cascade)
  sessions           WorkoutSession[]
  metricDefinitions  PlanMetricDefinition[]

  @@index([trainerId])
  @@index([studentId])
}

model WorkoutSession {
  id        String   @id @default(cuid())
  planId    String
  name      String
  dayOfWeek Int?
  order     Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())

  plan      WorkoutPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises SessionExercise[]
  logs      WorkoutLog[]

  @@index([planId])
}

model Exercise {
  id           String           @id @default(cuid())
  name         String
  muscleGroup  String
  videoUrl     String?
  imageUrl     String?
  instructions String?
  isCustom     Boolean          @default(false)
  createdById  String?
  // Categoria: separa exercícios de academia dos de corrida na biblioteca
  category     ExerciseCategory @default(ACADEMIA)
  createdAt    DateTime         @default(now())

  creator          User?             @relation("ExerciseCreator", fields: [createdById], references: [id])
  sessionExercises SessionExercise[]
  exerciseLogs     ExerciseLog[]

  @@index([muscleGroup])
  @@index([createdById])
  @@index([category])
}

model SessionExercise {
  id          String  @id @default(cuid())
  sessionId   String
  exerciseId  String
  sets        Int
  reps        String
  restSeconds Int?
  weight      Float?
  notes       String?
  order       Int     @default(0)

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([sessionId])
}

model WorkoutLog {
  id           String           @id @default(cuid())
  sessionId    String
  studentId    String
  startedAt    DateTime         @default(now())
  finishedAt   DateTime?
  status       WorkoutLogStatus @default(IN_PROGRESS)
  mode         WorkoutMode      @default(GUIDED)
  notes        String?
  studentNotes String?

  session      WorkoutSession @relation(fields: [sessionId], references: [id])
  student      User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exerciseLogs ExerciseLog[]

  @@index([studentId])
  @@index([sessionId])
  @@index([status])
}

model ExerciseLog {
  id            String   @id @default(cuid())
  workoutLogId  String
  exerciseId    String
  setNumber     Int
  weight        Float?
  reps          Int?
  completed     Boolean  @default(false)
  skipped       Boolean  @default(false)
  skippedReason String?
  loggedAt      DateTime @default(now())

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id])

  @@index([workoutLogId])
}

model BodyMetric {
  id           String   @id @default(cuid())
  studentId    String
  date         DateTime @default(now())
  weight       Float?
  bodyFat      Float?
  measurements Json?
  notes        String?
  photoUrl     String?  // optional photo attached to the evaluation
  createdAt    DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([date])
}

model ExamUpload {
  id         String   @id @default(cuid())
  studentId  String
  date       DateTime @default(now())
  type       String
  storageKey String
  fileName   String
  fileSize   Int
  mimeType   String?
  notes      String?
  createdAt  DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model RunningSession {
  id               String   @id @default(cuid())
  studentId        String
  date             DateTime @default(now())
  distanceKm       Float
  durationSeconds  Int
  paceSecondsPerKm Int
  caloriesBurned   Int?
  routeJson        Json?
  notes            String?
  // Origem do registro: "manual" (aluno digitou) ou "strava" (sync)
  source           String   @default("manual")
  // Id externo (ex.: Strava activity id) usado pra dedup nos syncs
  externalId       String?
  createdAt        DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, externalId])
  @@index([studentId])
  @@index([date])
}

/// Personal-defined custom metric to collect from the student during a plan.
/// Example: "Peso na barra do supino" (kg), or "Foto da execução do agachamento" (attachment required).
model PlanMetricDefinition {
  id                 String   @id @default(cuid())
  planId             String
  name               String
  unit               String?
  requiresAttachment Boolean  @default(false)
  order              Int      @default(0)
  createdAt          DateTime @default(now())

  plan WorkoutPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  logs PlanMetricLog[]

  @@index([planId])
}

model PlanMetricLog {
  id            String   @id @default(cuid())
  definitionId  String
  studentId     String
  value         String
  attachmentKey String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  definition PlanMetricDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  student    User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([definitionId])
  @@index([studentId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  vertical  Vertical?
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  readAt    DateTime?
  pushSent  Boolean          @default(false)
  pushError String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([createdAt])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// WebAuthn credential enrolled by the user (e.g. Face ID, Touch ID,
/// Windows Hello, a hardware security key). When at least one row
/// exists for a user, the in-app lock screen requires biometric
/// verification on every fresh app launch.
model PasskeyCredential {
  id           String   @id @default(cuid())
  userId       String
  /// Raw credential ID (Uint8Array) encoded as base64url. Unique because
  /// the WebAuthn spec guarantees no two credentials share an ID.
  credentialId String   @unique
  /// COSE-encoded public key, base64url. Used by the server to verify
  /// assertion signatures.
  publicKey    String
  /// Signature counter (bigint). Per the spec, the authenticator
  /// increments this with every assertion - a non-increasing counter
  /// can indicate credential cloning.
  counter      BigInt   @default(0)
  /// Transports the browser reported (internal, hybrid, nfc, usb, ble).
  /// Used to hint subsequent assertion ceremonies.
  transports   String[]
  /// Human-readable label shown in the manage-passkeys list. Optional;
  /// defaults to the user-agent at enrollment time if omitted.
  deviceLabel  String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationSettings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  morningReminder      Boolean @default(true)
  eveningReminder      Boolean @default(true)
  streakAlerts         Boolean @default(true)
  trainerActivity      Boolean @default(true)
  studentActivity      Boolean @default(true)
  morningReminderHour  Int     @default(7)
  eveningReminderHour  Int     @default(20)

  // Nutrição (round 4)
  nutricionistActivity Boolean @default(true)
  mealReminder         Boolean @default(true)
  mealReminderHours    Int[]   @default([7, 12, 19])
  hydrationReminder    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// User-defined goal — e.g. "5 treinos de Musculação por semana"
/// or "20 km de Corrida por mês". Progress is computed at read-time from
/// WorkoutLog (WORKOUT_COUNT) or RunningSession (DISTANCE_KM) over the
/// active window of `period`.
model Goal {
  id        String     @id @default(cuid())
  studentId String
  sport     String     // mirrors User.sportsPracticed ("Musculação", "Corrida", …)
  metric    GoalMetric
  target    Float
  period    GoalPeriod
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

/// Round 3: Follow-up forms — personal envia formulário ao aluno e recebe respostas.
model FollowUpFormTemplate {
  id          String   @id @default(cuid())
  trainerId   String
  name        String
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainer   User                   @relation("FollowUpCreator", fields: [trainerId], references: [id], onDelete: Cascade)
  questions FollowUpFormQuestion[]
  sends     FollowUpFormSend[]

  @@index([trainerId])
}

model FollowUpFormQuestion {
  id         String               @id @default(cuid())
  templateId String
  order      Int                  @default(0)
  label      String
  type       FollowUpQuestionType
  required   Boolean              @default(true)

  template FollowUpFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers  FollowUpFormAnswer[]

  @@index([templateId])
}

model FollowUpFormSend {
  id          String             @id @default(cuid())
  templateId  String
  trainerId   String
  studentId   String
  token       String             @unique
  status      FollowUpFormStatus @default(PENDING)
  expiresAt   DateTime
  sentAt      DateTime           @default(now())
  answeredAt  DateTime?

  template FollowUpFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  trainer  User                 @relation("FollowUpTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  student  User                 @relation("FollowUpStudent", fields: [studentId], references: [id], onDelete: Cascade)
  answers  FollowUpFormAnswer[]

  @@index([trainerId])
  @@index([studentId])
  @@index([token])
}

model FollowUpFormAnswer {
  id          String   @id @default(cuid())
  sendId      String
  questionId  String
  valueText   String?
  valueNumber Float?
  valueBool   Boolean?
  createdAt   DateTime @default(now())

  send     FollowUpFormSend     @relation(fields: [sendId], references: [id], onDelete: Cascade)
  question FollowUpFormQuestion @relation(fields: [questionId], references: [id])

  @@index([sendId])
}

/// Round 3: Eventos da agenda do personal (provas, sessões avulsas, avaliações).
/// `remindersHours` define quantas horas antes do evento disparar push.
/// `remindersFired` é mapa {offsetHours -> isoTimestamp} pra idempotência do cron.
model Event {
  id              String    @id @default(cuid())
  trainerId       String
  studentId       String?
  title           String
  type            EventType @default(OTHER)
  startsAt        DateTime
  durationMinutes Int?
  location        String?
  locationUrl     String?
  notes           String?
  remindersHours  Int[]     @default([24, 2])
  remindersFired  Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trainer User  @relation("EventTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  student User? @relation("EventStudent", fields: [studentId], references: [id], onDelete: SetNull)

  @@index([trainerId, startsAt])
  @@index([studentId, startsAt])
}

/// Round 3: Strava OAuth account vinculada a um User do AUGE.
/// Tokens accessToken/refreshToken CRIPTOGRAFADOS antes de salvar (AES-256-GCM via STRAVA_TOKEN_KEY).
model StravaAccount {
  id              String    @id @default(cuid())
  userId          String    @unique
  stravaAthleteId BigInt    @unique
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  scope           String
  firstName       String?
  lastName        String?
  profileImageUrl String?
  lastSyncAt      DateTime?
  connectedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stravaAthleteId])
}

/// Round 3: Atividade sincronizada do Strava (cópia rica do payload Strava).
/// Para type Run/TrailRun/VirtualRun é espelhada em RunningSession via source='strava' + externalId.
model StravaActivity {
  id                 String   @id @default(cuid())
  studentId          String
  stravaActivityId   BigInt   @unique
  type               String
  name               String
  distanceMeters     Float
  movingTimeSeconds  Int
  elapsedTimeSeconds Int
  startDate          DateTime
  averageHeartrate   Float?
  maxHeartrate       Float?
  averageSpeed       Float?
  totalElevationGain Float?
  calories           Float?
  polyline           String?
  raw                Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, startDate])
  @@index([type])
}

// ============================================================================
// Round 4 — Vertical de Nutrição (ver PLANO-NUTRICAO-VERTICAL.md)
// ============================================================================

enum Vertical {
  TREINOS
  NUTRICAO
  FISIO
  MENTAL
  SONO
}

enum NutritionistStudentStatus {
  PENDING
  ACTIVE
  PAUSED
  ENDED
}

enum MealLogStatus {
  PENDING
  LOGGED
  SKIPPED
  PARTIAL
}

enum MealLogMode {
  GUIDED
  FREE
}

model NutritionistStudent {
  id             String                    @id @default(cuid())
  nutritionistId String
  studentId      String
  status         NutritionistStudentStatus @default(ACTIVE)
  inviteId       String?
  startedAt      DateTime                  @default(now())
  endedAt        DateTime?

  nutritionist User @relation("NutritionistRelation", fields: [nutritionistId], references: [id], onDelete: Cascade)
  student      User @relation("NutriAlunoRelation",    fields: [studentId],      references: [id], onDelete: Cascade)

  @@unique([nutritionistId, studentId])
  @@index([nutritionistId, status])
  @@index([studentId, status])
}

model InviteCodeNutri {
  id             String       @id @default(cuid())
  code           String       @unique
  nutritionistId String
  status         InviteStatus @default(ACTIVE)
  usedById       String?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  usedAt         DateTime?

  nutritionist User  @relation("InviteNutriCreator",  fields: [nutritionistId], references: [id], onDelete: Cascade)
  usedBy       User? @relation("InviteNutriConsumer", fields: [usedById],       references: [id], onDelete: SetNull)

  @@index([code])
  @@index([nutritionistId])
}

model MealPlan {
  id              String    @id @default(cuid())
  nutritionistId  String?
  studentId       String
  name            String
  description     String?
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean   @default(true)
  pausedAt        DateTime?
  targetCalories  Int?
  targetProteinG  Int?
  targetCarbsG    Int?
  targetFatG      Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  nutritionist User? @relation("MealPlanCreator", fields: [nutritionistId], references: [id], onDelete: SetNull)
  student      User  @relation("MealPlanOwner",   fields: [studentId],      references: [id], onDelete: Cascade)

  meals Meal[]

  @@index([studentId, isActive])
  @@index([nutritionistId])
}

model Meal {
  id        String     @id @default(cuid())
  planId    String
  name      String
  timeOfDay String?
  dayOfWeek Int?
  order     Int
  notes     String?

  plan  MealPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  items MealItem[]
  logs  MealLog[]

  @@index([planId])
}

model MealItem {
  id       String @id @default(cuid())
  mealId   String
  foodId   String
  quantity Float
  unit     String
  notes    String?
  order    Int

  meal Meal        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food FoodCatalog @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([mealId])
  @@index([foodId])
}

model FoodCatalog {
  id             String  @id @default(cuid())
  name           String
  brand          String?
  isCustom       Boolean @default(false)
  createdById    String?
  source         String  // "TACO" | "USDA" | "USER"
  kcalPer100g    Float
  proteinPer100g Float
  carbsPer100g   Float
  fatPer100g     Float
  fiberPer100g   Float?

  createdBy User?         @relation("FoodCatalogCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     MealItem[]
  itemLogs  MealItemLog[]

  @@index([name])
  @@index([createdById])
}

model MealLog {
  id           String        @id @default(cuid())
  mealId       String
  studentId    String
  date         DateTime      @db.Date
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  status       MealLogStatus @default(PENDING)
  mode         MealLogMode   @default(GUIDED)
  notes        String?
  studentNotes String?
  photoKey     String?

  meal    Meal          @relation(fields: [mealId],    references: [id], onDelete: Cascade)
  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items   MealItemLog[]

  @@index([studentId, date])
  @@index([mealId, date])
}

model MealItemLog {
  id            String   @id @default(cuid())
  mealLogId     String
  foodId        String
  grams         Float?
  consumed      Boolean
  skipped       Boolean  @default(false)
  skippedReason String?
  loggedAt      DateTime @default(now())

  mealLog MealLog     @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  food    FoodCatalog @relation(fields: [foodId],    references: [id], onDelete: Restrict)

  @@index([mealLogId])
}

model HydrationLog {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime @db.Date
  ml        Int
  source    String   // "manual" | "reminder"
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, date])
