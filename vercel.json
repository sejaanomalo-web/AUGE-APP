  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/morning",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/evening",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/events",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/strava-refresh",
      "schedule": "0 4 * * *"
    }
  ]
}
